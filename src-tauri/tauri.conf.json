{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Numpad Clipboard",
  "version": "0.1.0",
  "identifier": "app.numpadclipboard",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Clipboard slots",
        "width": 300,
        "height": 372,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
