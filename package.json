{
  "name": "c-slot",
  "productName": "C-Slot",
  "description": "Minimalist Clipboard Manager for Windows",
  "version": "0.1.0",
  "main": "main.js",
  "author": "Md Ruwaid uddin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Md-Ruwaid/C-slot.git"
  },
  "homepage": "https://github.com/Md-Ruwaid/C-slot#readme",
  "bugs": {
    "url": "https://github.com/Md-Ruwaid/C-slot/issues"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "electron",
    "windows",
    "productivity",
    "hotkeys",
    "numpad"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "web": "node website/server.js",
    "build": "echo 'Static build ready'"
  },
  "build": {
    "appId": "com.cslot.app",
    "productName": "C-Slot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.ico",
      "icon.png",
      "src/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "C-Slot"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
